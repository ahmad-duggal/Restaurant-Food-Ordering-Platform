# Backend Environment Variables — EXAMPLE FILE
# Copy this to .env and fill in your real values
# NEVER commit .env to GitHub

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/restaurantDB?retryWrites=true&w=majority
NODE_ENV=production
JWT_SECRET=your_super_strong_jwt_secret_here_min_32_chars
JWT_EXPIRE=7d
CLIENT_URL=https://your-frontend.vercel.app
